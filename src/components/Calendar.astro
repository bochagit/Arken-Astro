---
interface Props {
	googleCalendarApiKey: string;
	googleCalendarId: string;
	locale?: string;
	buttonText?: {
		today?: string;
		month?: string;
		week?: string;
		day?: string;
	};
}

const {
	googleCalendarApiKey,
	googleCalendarId,
	locale = 'en',
	buttonText = {
		today: 'Today',
		month: 'Month',
		week: 'Week',
		day: 'Day'
	}
} = Astro.props;
---

<div class="torneos__calendar-layout">
	<div class="torneos__calendar-copy">
		<h2 class="torneos__calendar-title">{locale === 'es' ? 'Calendario de torneos' : 'Tournament calendar'}</h2>
		<p class="torneos__calendar-description">{locale === 'es' ? 'Consultá las próximas fechas de torneos de Unmatched en Argentina. Encontrá sedes, horarios y accedé a la información de cada evento.' : 'Check out the upcoming Unmatched tournament dates in Argentina. Find venues, times, and access information about each event.'}</p>
	</div>

	<section class="torneos__calendar" data-google-calendar-api-key={googleCalendarApiKey} data-google-calendar-id={googleCalendarId} data-locale={locale} data-button-text={JSON.stringify(buttonText)}>
		<div id="fc-calendar"></div>
	</section>
</div>

<script type="module">
	import { Calendar } from 'https://esm.sh/@fullcalendar/core@6.1.20';
	import dayGridPlugin from 'https://esm.sh/@fullcalendar/daygrid@6.1.20';
	import timeGridPlugin from 'https://esm.sh/@fullcalendar/timegrid@6.1.20';
	import googleCalendarPlugin from 'https://esm.sh/@fullcalendar/google-calendar@6.1.20';

	document.addEventListener('DOMContentLoaded', async () => {
		const el = document.getElementById('fc-calendar');
		if (!el) return;

		const calendarSection = el.closest('.torneos__calendar');
		const googleCalendarApiKey = calendarSection?.dataset.googleCalendarApiKey || '';
		const googleCalendarId = calendarSection?.dataset.googleCalendarId || '';
		const locale = calendarSection?.dataset.locale || 'en';
		const buttonText = calendarSection?.dataset.buttonText ? JSON.parse(calendarSection.dataset.buttonText) : undefined;

		const calendarConfig = {
			plugins: [dayGridPlugin, timeGridPlugin, googleCalendarPlugin],
			initialView: 'dayGridMonth',
			googleCalendarApiKey,
			events: { googleCalendarId },
			timeZone: 'America/Argentina/Buenos_Aires',
			height: 'auto',
			headerToolbar: { left: 'prev,next today', center: 'title', right: 'dayGridMonth,timeGridWeek,timeGridDay' },
			buttonText,
			eventClick(info) {
				if (info.event.url) {
					info.jsEvent.preventDefault();
					window.open(info.event.url, '_blank');
				}
			}
		};

		if (locale === 'es') {
			const esLocale = await import('https://esm.sh/@fullcalendar/core@6.1.20/locales/es.js').then((module) => module.default);
			calendarConfig.locales = [esLocale];
			calendarConfig.locale = 'es';
		}

		const calendar = new Calendar(el, calendarConfig);
		calendar.render();
	});
</script>