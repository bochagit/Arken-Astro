---
interface Props {
	googleCalendarApiKey: string
	googleCalendarId: string
	locale?: string
}

const { googleCalendarApiKey, googleCalendarId, locale = 'es' } = Astro.props
---

<div class="torneos__calendar-layout">
	<div class="torneos__calendar-copy">
		<h2 class="torneos__calendar-title">
			{locale === 'es' ? 'Próximos torneos' : 'Upcoming tournaments'}
		</h2>

		<p class="torneos__calendar-description">
			{
				locale === 'es'
					? 'Consultá las próximas fechas de torneos de Unmatched en Argentina.'
					: 'Check out upcoming Unmatched tournaments in Argentina.'
			}
		</p>
	</div>

	<div id="events-container" class="torneos__events-list">
		<p>Cargando torneos...</p>
	</div>
</div>

<script
	define:vars={{
		googleCalendarApiKey,
		googleCalendarId,
		locale
	}}
>
	const container = document.getElementById('events-container')

	async function loadEvents() {
		try {
			const now = new Date().toISOString()

			const response = await fetch(
				`https://www.googleapis.com/calendar/v3/calendars/${encodeURIComponent(
					googleCalendarId
				)}/events?key=${googleCalendarApiKey}&singleEvents=true&orderBy=startTime&timeMin=${now}&maxResults=20`
			)

			const data = await response.json()

			console.log('Google Calendar Response:', data)

			const events = data.items || []

			if (events.length === 0) {
				container.innerHTML = '<p>No hay torneos programados.</p>'
				return
			}

			container.innerHTML = events
				.map((event) => {
					const startDate = event.start?.dateTime || event.start?.date

					const formattedDate = new Date(startDate).toLocaleString(
						locale === 'es' ? 'es-AR' : 'en-US',
						{
							dateStyle: 'full',
							timeStyle: event.start?.dateTime ? 'short' : undefined
						}
					)

					return `
						<article class="torneos__event-card">
							<div class="torneos__event-content">
								<h3 class="torneos__event-title">
									${event.summary ?? 'Torneo'}
								</h3>

								<p class="torneos__event-date">
									${formattedDate}
								</p>

								${
									event.location
										? `
										<p class="torneos__event-location">
											${event.location}
										</p>
									`
										: ''
								}
							</div>

							<a
								class="torneos__event-button"
								href="${event.htmlLink}"
								target="_blank"
								rel="noopener noreferrer"
							>
								Ver evento
							</a>
						</article>
					`
				})
				.join('')
		} catch (error) {
			console.error(error)

			container.innerHTML = '<p>Error al cargar los torneos.</p>'
		}
	}

	loadEvents()
</script>
